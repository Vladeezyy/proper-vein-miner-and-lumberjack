  "contact": {
    "homepage": "https://github.com/Vladeezyy/proper-vein-miner-and-lumberjack",
    "sources": "https://github.com/Vladeezyy/proper-vein-miner-and-lumberjack",
    "issues": "https://github.com/Vladeezyy/proper-vein-miner-and-lumberjack/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/properveinminer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.vladeezyy.properveinminer.ProperVeinMinerFabric"],
    "client": ["io.github.vladeezyy.properveinminer.ProperVeinMinerFabricClient"],
    "modmenu": ["io.github.vladeezyy.properveinminer.ModMenuIntegration"]
  },
  "mixins": ["properveinminer.mixins.json"],
  "accessWidener": "properveinminer.ct",
